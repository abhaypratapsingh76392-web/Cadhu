# CashPe — KOI KEY DALNE KI ZAROORAT NAHI
# Render par deploy karte hi sab automatic hota hai.
# Pehla registered user = ADMIN (real admin, koi demo nahi).
# Firebase config deploy ke baad Admin Panel -> Settings me paste karo —
# usi ek config se Google login (Firebase Auth) + Firestore sync dono chalenge.

# Database (sirf local development ke liye; Render par automatic)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Commission percent
COMMISSION_PERCENT=2
